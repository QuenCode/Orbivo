<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Orbivo.Audio\Orbivo.Audio.csproj" />
    <ProjectReference Include="..\..\src\Orbivo.Core\Orbivo.Core.csproj" />
  </ItemGroup>

  <!-- phonon.dll for the Steam Audio tests (they are skipped when it is missing). -->
  <Import Project="$(OrbivoRepoRoot)build\Native.targets" />

  <ItemGroup>
    <!-- Same culture for every test run, whatever the Windows language (docs/DECISIONS.md, M11). -->
    <Content Include="..\xunit.runner.json" Link="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
