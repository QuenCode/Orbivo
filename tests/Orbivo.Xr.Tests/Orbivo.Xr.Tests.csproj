<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Renderer tests on WARP (software rasterizer of Windows, no GPU needed).
    WPF is only used to read and write PNG files (WIC), like the app does.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Orbivo.Xr\Orbivo.Xr.csproj" />
  </ItemGroup>

</Project>
