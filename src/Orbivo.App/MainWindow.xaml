<Window x:Class="Orbivo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Orbivo.App.ViewModels"
        xmlns:local="clr-namespace:Orbivo.App"
        xmlns:lv="clr-namespace:Orbivo.App.LiveView"
        xmlns:loc="clr-namespace:Orbivo.App.Localization"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding Title}"
        Icon="/Assets/orbivo.ico"
        Width="1280" Height="800" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="OnPlaylistDrop" DragOver="OnPlaylistDragOver"
        PreviewKeyDown="OnWindowPreviewKeyDown">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="VisibleIfTrue" />
  </Window.Resources>

  <DockPanel>
  <!-- Menu bar (M11): file, playback (auto-advance, loop), options (language, sound lock) and help. Settings that are
       rarely changed live here. -->
  <Menu DockPanel.Dock="Top" Padding="2">
    <MenuItem Header="{x:Static loc:UiText.MenuFile}">
      <MenuItem Header="{x:Static loc:UiText.MenuAddVideos}" Click="OnAddFilesClick" />
      <MenuItem Header="{x:Static loc:UiText.MenuClearPlaylist}" Command="{Binding ClearPlaylistCommand}"
                ToolTip="{x:Static loc:UiText.MenuClearPlaylistTip}" ToolTipService.ShowOnDisabled="True" />
      <Separator />
      <MenuItem Header="{x:Static loc:UiText.MenuExit}" Click="OnExitClick" />
    </MenuItem>
    <MenuItem Header="{x:Static loc:UiText.MenuPlayback}">
      <MenuItem Header="{x:Static loc:UiText.MenuAutoAdvance}" IsCheckable="True" IsChecked="{Binding AutoAdvance}"
                ToolTip="{x:Static loc:UiText.MenuAutoAdvanceTip}" />
      <MenuItem Header="{x:Static loc:UiText.MenuLoop}" IsCheckable="True" IsChecked="{Binding Loop}"
                ToolTip="{x:Static loc:UiText.MenuLoopTip}" />
    </MenuItem>
    <MenuItem Header="{x:Static loc:UiText.MenuOptions}">
      <!-- Named in both languages, so it is found whatever language the window shows -->
      <MenuItem Header="Sprache / _Language" ToolTip="{x:Static loc:UiText.LanguageTip}">
        <MenuItem Header="English" IsChecked="{Binding EnglishSelected, Mode=OneWay}" Command="{Binding ChooseLanguageCommand}" CommandParameter="en" />
        <MenuItem Header="Deutsch" IsChecked="{Binding GermanSelected, Mode=OneWay}" Command="{Binding ChooseLanguageCommand}" CommandParameter="de" />
      </MenuItem>
      <MenuItem Header="{x:Static loc:UiText.MenuSoundLock}" IsCheckable="True" IsChecked="{Binding SoundLocked}"
                ToolTip="{x:Static loc:UiText.SoundLockTip}" />
    </MenuItem>
    <MenuItem Header="{x:Static loc:UiText.MenuHelp}">
      <MenuItem Header="{x:Static loc:UiText.MenuManual}" InputGestureText="F1" Command="{Binding OpenManualCommand}"
                ToolTip="{x:Static loc:UiText.ManualTip}" />
      <MenuItem Header="{x:Static loc:UiText.MenuAbout}" Command="{Binding ShowAboutCommand}" />
    </MenuItem>
  </Menu>

  <Grid Margin="6">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="2*" MinWidth="320" />
      <ColumnDefinition Width="3*" MinWidth="420" />
    </Grid.ColumnDefinitions>

    <Grid Grid.Row="0" Grid.Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Playlist (F1–F3), compact: usually one to three videos. File dialog, drag and drop from Explorer, order, auto-advance, loop -->
      <GroupBox Grid.Row="0" Header="Playlist">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <WrapPanel>
              <Button Content="{x:Static loc:UiText.PlaylistAdd}" Click="OnAddFilesClick" Margin="0,0,6,4"
                      ToolTip="{x:Static loc:UiText.PlaylistAddTip}" />
              <Button Content="{x:Static loc:UiText.PlaylistLoad}" Command="{Binding LoadSelectedCommand}" Margin="0,0,6,4"
                      ToolTip="{x:Static loc:UiText.PlaylistLoadTip}" />
              <Button Content="{x:Static loc:UiText.PlaylistRemove}" Command="{Binding RemoveSelectedCommand}" Margin="0,0,6,4" ToolTipService.ShowOnDisabled="True"
                      ToolTip="{x:Static loc:UiText.PlaylistRemoveTip}" />
              <Button Content="▲" MinWidth="36" Command="{Binding MoveSelectedUpCommand}" Margin="0,0,6,4" ToolTip="{x:Static loc:UiText.PlaylistUpTip}" />
              <Button Content="▼" MinWidth="36" Command="{Binding MoveSelectedDownCommand}" Margin="0,0,6,4" ToolTip="{x:Static loc:UiText.PlaylistDownTip}" />
            </WrapPanel>
          </StackPanel>
          <Grid>
            <ListBox x:Name="PlaylistBox" Height="112" ItemsSource="{Binding Playlist.Entries}" SelectedItem="{Binding SelectedEntry}"
                     AllowDrop="True" Drop="OnPlaylistDrop" DragOver="OnPlaylistDragOver"
                     MouseDoubleClick="OnPlaylistDoubleClick" KeyDown="OnPlaylistKeyDown"
                     HorizontalContentAlignment="Stretch">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel ToolTip="{Binding Path}">
                    <TextBlock x:Name="Marker" DockPanel.Dock="Left" Width="18" Text="" />
                    <TextBlock x:Name="Name" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                  </DockPanel>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                      <Setter TargetName="Marker" Property="Text" Value="▶" />
                      <Setter TargetName="Name" Property="FontWeight" Value="Bold" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Style="{StaticResource PlaceholderText}" Margin="12" IsHitTestVisible="False"
                       Text="{x:Static loc:UiText.PlaylistEmpty}">
              <TextBlock.Visibility>
                <Binding Path="Playlist.Entries.Count">
                  <Binding.Converter>
                    <local:ZeroToVisibleConverter />
                  </Binding.Converter>
                </Binding>
              </TextBlock.Visibility>
            </TextBlock>
          </Grid>
        </DockPanel>
      </GroupBox>

      <!-- Format (M6, F10–F14): applied at once and stored in <video>.orbivo.json -->
      <GroupBox Grid.Row="1" Header="Format" DataContext="{Binding Format}">
        <Grid IsEnabled="{Binding IsAvailable}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.Resources>
            <BooleanToVisibilityConverter x:Key="VisibleIf" />
            <Style TargetType="TextBlock">
              <Setter Property="Margin" Value="0,2,16,2" />
              <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style TargetType="ComboBox">
              <Setter Property="Margin" Value="0,2,0,2" />
              <Setter Property="Focusable" Value="False" />
              <Setter Property="DisplayMemberPath" Value="Label" />
            </Style>
            <Style x:Key="FieldLabel" TargetType="TextBlock">
              <Setter Property="Margin" Value="0,2,4,2" />
              <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="NumberBox" TargetType="TextBox">
              <Setter Property="Width" Value="56" />
              <Setter Property="Margin" Value="0,2,10,2" />
              <Setter Property="VerticalContentAlignment" Value="Center" />
              <EventSetter Event="LostKeyboardFocus" Handler="OnFormatFieldLostFocus" />
            </Style>
            <Style x:Key="HintText" TargetType="TextBlock">
              <Setter Property="TextWrapping" Value="Wrap" />
              <Style.Triggers>
                <Trigger Property="Text" Value="">
                  <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </Grid.Resources>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static loc:UiText.FormatProjection}" />
          <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Projections}" SelectedItem="{Binding SelectedProjection}"
                    ToolTip="{x:Static loc:UiText.FormatProjectionTip}" />

          <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static loc:UiText.FormatLayout}" />
          <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Layouts}" SelectedItem="{Binding SelectedLayout}"
                    IsEnabled="{Binding CanChooseLayout}"
                    ToolTip="{x:Static loc:UiText.FormatLayoutTip}" />

          <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static loc:UiText.FormatEyes}" />
          <CheckBox Grid.Row="2" Grid.Column="1" Content="{x:Static loc:UiText.FormatSwapEyes}" IsChecked="{Binding SwapEyes}" IsEnabled="{Binding CanSwapEyes}"
                    Focusable="False" VerticalAlignment="Center" Margin="0,2,0,2"
                    ToolTip="{x:Static loc:UiText.FormatSwapEyesTip}" />

          <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static loc:UiText.FormatCubemap}" Visibility="{Binding ShowsCubemap, Converter={StaticResource VisibleIf}}" />
          <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding CubemapLayouts}" SelectedItem="{Binding SelectedCubemap}"
                    Visibility="{Binding ShowsCubemap, Converter={StaticResource VisibleIf}}"
                    ToolTip="{x:Static loc:UiText.FormatCubemapTip}" />

          <TextBlock Grid.Row="4" Grid.Column="0" Text="Fisheye:" Visibility="{Binding ShowsFisheye, Converter={StaticResource VisibleIf}}" />
          <WrapPanel Grid.Row="4" Grid.Column="1" Visibility="{Binding ShowsFisheye, Converter={StaticResource VisibleIf}}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static loc:UiText.FormatFov}" />
            <TextBox Style="{StaticResource NumberBox}" Text="{Binding FovText, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding ApplyFisheyeCommand}"
                     ToolTip="{x:Static loc:UiText.FormatFovTip}">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding ApplyFisheyeCommand}" />
              </TextBox.InputBindings>
            </TextBox>
            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static loc:UiText.FormatCenterX}" />
            <TextBox Style="{StaticResource NumberBox}" Text="{Binding CenterXText, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding ApplyFisheyeCommand}"
                     ToolTip="{x:Static loc:UiText.FormatCenterXTip}">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding ApplyFisheyeCommand}" />
              </TextBox.InputBindings>
            </TextBox>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Y" />
            <TextBox Style="{StaticResource NumberBox}" Text="{Binding CenterYText, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding ApplyFisheyeCommand}"
                     ToolTip="{x:Static loc:UiText.FormatCenterYTip}">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding ApplyFisheyeCommand}" />
              </TextBox.InputBindings>
            </TextBox>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Radius" />
            <TextBox Style="{StaticResource NumberBox}" Text="{Binding RadiusText, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding ApplyFisheyeCommand}"
                     ToolTip="{x:Static loc:UiText.FormatRadiusTip}">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding ApplyFisheyeCommand}" />
              </TextBox.InputBindings>
            </TextBox>
            <Button Content="{x:Static loc:UiText.FormatFisheyeDefault}" MinWidth="0" Command="{Binding ResetFisheyeCommand}" Focusable="False" ToolTip="{x:Static loc:UiText.FormatFisheyeDefaultTip}" />
          </WrapPanel>

          <TextBlock Grid.Row="5" Grid.Column="0" Text="{x:Static loc:UiText.FormatOrientation}" />
          <WrapPanel Grid.Row="5" Grid.Column="1">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Yaw °" />
            <TextBox Style="{StaticResource NumberBox}" Text="{Binding YawText, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding ApplyOffsetCommand}"
                     ToolTip="{x:Static loc:UiText.FormatYawTip}">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding ApplyOffsetCommand}" />
              </TextBox.InputBindings>
            </TextBox>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Pitch °" />
            <TextBox Style="{StaticResource NumberBox}" Text="{Binding PitchText, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding ApplyOffsetCommand}"
                     ToolTip="{x:Static loc:UiText.FormatPitchTip}">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding ApplyOffsetCommand}" />
              </TextBox.InputBindings>
            </TextBox>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Roll °" />
            <TextBox Style="{StaticResource NumberBox}" Text="{Binding RollText, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding ApplyOffsetCommand}"
                     ToolTip="{x:Static loc:UiText.FormatRollTip}">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding ApplyOffsetCommand}" />
              </TextBox.InputBindings>
            </TextBox>
            <Button Content="0" MinWidth="0" Command="{Binding ResetOffsetCommand}" Focusable="False" ToolTip="{x:Static loc:UiText.FormatOrientationResetTip}" />
          </WrapPanel>

          <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource HintText}" Text="{Binding InputError}" Foreground="Firebrick" />

          <TextBlock Grid.Row="7" Grid.Column="0" Text="{x:Static loc:UiText.FormatMetadata}" />
          <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding MetadataText}" TextWrapping="Wrap" />

          <TextBlock Grid.Row="8" Grid.Column="0" Text="Sidecar:" />
          <DockPanel Grid.Row="8" Grid.Column="1">
            <Button DockPanel.Dock="Right" Content="{x:Static loc:UiText.FormatResetAll}" Command="{Binding ResetAllCommand}" Focusable="False" Margin="6,2,0,2"
                    ToolTip="{x:Static loc:UiText.FormatResetAllTip}" />
            <TextBlock Text="{Binding SidecarText}" TextWrapping="Wrap" />
          </DockPanel>

          <TextBlock Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource HintText}" Text="{Binding WarningText}"
                     Foreground="DarkGoldenrod" Margin="0,6,0,0" />
        </Grid>
      </GroupBox>

      <!-- Live view (F42): what the viewer sees, copied from the render thread about 30 times per second -->
      <GroupBox Grid.Row="2" Header="{x:Static loc:UiText.LiveViewHeader}">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <CheckBox Content="{x:Static loc:UiText.LiveViewShow}" IsChecked="{Binding LiveViewEnabled}" Focusable="False" VerticalAlignment="Center"
                      ToolTip="{x:Static loc:UiText.LiveViewShowTip}" />
            <TextBlock Text="{Binding LiveViewStatusText}" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </DockPanel>
          <Grid Background="Black" MinHeight="120">
            <lv:LiveViewHost x:Name="LiveViewPanel" Visibility="{Binding LiveViewEnabled, Converter={StaticResource VisibleIfTrue}}" />
            <TextBlock Text="{x:Static loc:UiText.Off}" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding LiveViewEnabled}" Value="True">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
        </DockPanel>
      </GroupBox>
    </Grid>

    <Grid Grid.Row="0" Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>


      <!-- Sound (M5): mode and output device (F24) -->
      <GroupBox Grid.Row="0" Header="{x:Static loc:UiText.SoundHeader}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static loc:UiText.SoundAudioMode}" Margin="0,2,16,2" />
          <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AudioModeText}" TextWrapping="Wrap" Margin="0,2,0,2" />
          <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static loc:UiText.SoundFormat}" VerticalAlignment="Center" Margin="0,2,16,2" />
          <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Format.AudioModes}" SelectedItem="{Binding Format.SelectedAudioMode}"
                    IsEnabled="{Binding Format.CanChooseAudioMode}" Focusable="False" Margin="0,2,0,2" HorizontalAlignment="Left" MinWidth="260"
                    ToolTip="{x:Static loc:UiText.SoundFormatTip}" />
          <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static loc:UiText.SoundDirection}" VerticalAlignment="Center" Margin="0,2,16,2" />
          <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,2,0,2">
            <CheckBox Content="{x:Static loc:UiText.SoundFixed}" IsChecked="{Binding Format.SoundFixedToPicture}" IsEnabled="{Binding Format.IsAvailable}"
                      Focusable="False" VerticalAlignment="Center"
                      ToolTip="{x:Static loc:UiText.SoundFixedTip}" />
            <TextBlock Text="{x:Static loc:UiText.SoundWidth}" VerticalAlignment="Center" Margin="16,0,6,0" />
            <ComboBox ItemsSource="{Binding Format.StereoWidths}" SelectedItem="{Binding Format.SelectedStereoWidth}"
                      IsEnabled="{Binding Format.CanChooseStereoWidth}" Focusable="False" MinWidth="110" HorizontalAlignment="Left"
                      ToolTip="{x:Static loc:UiText.SoundWidthTip}" />
          </DockPanel>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static loc:UiText.SoundOutput}" VerticalAlignment="Center" Margin="0,2,16,2" />
          <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,2,0,2">
            <Button DockPanel.Dock="Right" Content="{x:Static loc:UiText.SoundRefresh}" Command="{Binding RefreshAudioDevicesCommand}" Margin="6,0,0,0"
                    ToolTip="{x:Static loc:UiText.SoundRefreshTip}" />
            <ComboBox ItemsSource="{Binding AudioDevices}" SelectedItem="{Binding SelectedAudioDevice}" Focusable="False"
                      IsEnabled="{Binding SoundSettingsEditable}"
                      ToolTip="{x:Static loc:UiText.SoundDeviceTip}" />
          </DockPanel>
          <!-- The lock itself is in the menu Options; here only the reminder why device and volume are greyed out -->
          <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Static loc:UiText.SoundLockedHint}" TextWrapping="Wrap"
                     Foreground="DarkGoldenrod" Margin="0,4,0,2"
                     Visibility="{Binding SoundLocked, Converter={StaticResource VisibleIfTrue}}"
                     ToolTip="{x:Static loc:UiText.SoundLockTip}" />
        </Grid>
      </GroupBox>

      <!-- Idle view (F7): what the headset shows while no video runs; kept in settings.json -->
      <GroupBox Grid.Row="1" Header="{x:Static loc:UiText.IdleHeader}" DataContext="{Binding Idle}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static loc:UiText.IdleDisplay}" VerticalAlignment="Center" Margin="0,2,16,2" />
          <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,2,0,2">
            <Button DockPanel.Dock="Right" Content="{x:Static loc:UiText.IdleChooseImage}" Click="OnChooseIdleImageClick" Margin="6,0,0,0" Focusable="False"
                    ToolTip="{x:Static loc:UiText.IdleChooseImageTip}" />
            <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" DisplayMemberPath="Label" Focusable="False"
                      MinWidth="200" HorizontalAlignment="Left"
                      ToolTip="{x:Static loc:UiText.IdleChoiceTip}" />
          </DockPanel>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static loc:UiText.IdleImage}" Margin="0,2,16,2"
                     Visibility="{Binding ShowsImageRow, Converter={StaticResource VisibleIfTrue}}" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ImageText}" TextWrapping="Wrap" Margin="0,2,0,2"
                     ToolTip="{Binding ImagePath}" Visibility="{Binding ShowsImageRow, Converter={StaticResource VisibleIfTrue}}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ImageLevel}" Value="{x:Static vm:StatusLevel.Error}">
                    <Setter Property="Foreground" Value="Firebrick" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="See-through:" Margin="0,2,16,2" />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SeeThroughText}" TextWrapping="Wrap" Margin="0,2,0,2" />
        </Grid>
      </GroupBox>

      <!-- Recording (F50-F52): head log and event log as German CSV; on, folder and rate kept in settings.json -->
      <GroupBox Grid.Row="2" Header="{x:Static loc:UiText.RecordingHeader}" DataContext="{Binding Recording}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <WrapPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,2,0,2">
            <CheckBox Content="{x:Static loc:UiText.RecordingEnable}" IsChecked="{Binding Enabled}" Focusable="False" Margin="0,0,24,0"
                      ToolTip="{x:Static loc:UiText.RecordingEnableTip}" />
            <CheckBox Content="{x:Static loc:UiText.RecordingPerVideo}" IsChecked="{Binding PerVideo}" IsEnabled="{Binding CanEdit}" Focusable="False"
                      ToolTip="{x:Static loc:UiText.RecordingPerVideoTip}" />
          </WrapPanel>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static loc:UiText.RecordingFolder}" VerticalAlignment="Center" Margin="0,2,16,2" />
          <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,2,0,2">
            <Button DockPanel.Dock="Right" Content="{x:Static loc:UiText.RecordingChooseFolder}" Click="OnChooseRecordingFolderClick" Margin="6,0,0,0" Focusable="False"
                    IsEnabled="{Binding CanEdit}" ToolTip="{x:Static loc:UiText.RecordingChooseFolderTip}" />
            <TextBlock Text="{Binding Folder}" ToolTip="{Binding Folder}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static loc:UiText.RecordingLabel}" VerticalAlignment="Center" Margin="0,2,16,2" />
          <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" Margin="0,2,0,2"
                   ToolTip="{x:Static loc:UiText.RecordingLabelTip}" />
          <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static loc:UiText.RecordingRate}" VerticalAlignment="Center" Margin="0,2,16,2" />
          <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Rates}" SelectedItem="{Binding SelectedRate}" DisplayMemberPath="Label" Focusable="False"
                    MinWidth="200" HorizontalAlignment="Left" Margin="0,2,0,2"
                    ToolTip="{x:Static loc:UiText.RecordingRateTip}" />
          <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding StatusLevel}" Value="{x:Static vm:StatusLevel.Error}">
                      <Setter Property="Foreground" Value="Firebrick" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StatusLevel}" Value="{x:Static vm:StatusLevel.Warning}">
                      <Setter Property="Foreground" Value="DarkGoldenrod" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding FileText}" ToolTip="{Binding FilePath}" TextTrimming="CharacterEllipsis">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Style.Triggers>
                    <Trigger Property="Text" Value="">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Grid>
      </GroupBox>

      <!-- Status (F40/F41, filled from M2 on) -->
      <GroupBox Grid.Row="3" Header="Status">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding StatusEntries}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:StatusEntry}">
                <Grid Margin="0,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Ellipse x:Name="Indicator" Grid.Column="0" Width="10" Height="10"
                           VerticalAlignment="Center" Fill="LightGray" />
                  <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold" />
                  <TextBox Grid.Column="2" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True"
                           BorderThickness="0" Background="Transparent" TextWrapping="Wrap" />
                </Grid>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Level}" Value="{x:Static vm:StatusLevel.Ok}">
                    <Setter TargetName="Indicator" Property="Fill" Value="ForestGreen" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Level}" Value="{x:Static vm:StatusLevel.Warning}">
                    <Setter TargetName="Indicator" Property="Fill" Value="Orange" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Level}" Value="{x:Static vm:StatusLevel.Error}">
                    <Setter TargetName="Indicator" Property="Fill" Value="Firebrick" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </GroupBox>
    </Grid>

    <!-- Transport (F2, F5, F60): timeline, time input, playlist navigation, blackout and fade -->
    <GroupBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Header="{x:Static loc:UiText.PlaybackHeader}">
      <StackPanel>
        <Border x:Name="OutputBanner" Padding="10,6" Margin="0,0,0,8" CornerRadius="3">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="#FF303030" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding OutputStatusLevel}" Value="{x:Static vm:StatusLevel.Ok}">
                  <Setter Property="Background" Value="#FF2E7D32" />
                </DataTrigger>
                <DataTrigger Binding="{Binding OutputStatusLevel}" Value="{x:Static vm:StatusLevel.Warning}">
                  <Setter Property="Background" Value="#FFB26A00" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock Text="{Binding OutputText}" Foreground="White" FontSize="16" FontWeight="SemiBold" />
        </Border>
        <DockPanel Margin="0,0,0,8">
          <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center"
                     FontFamily="Consolas" FontSize="14" Text="{Binding TimeText}" />
          <Slider x:Name="Timeline" VerticalAlignment="Center" Minimum="0" Maximum="{Binding DurationSeconds}"
                  Value="{Binding TimelineSeconds}" IsMoveToPointEnabled="True" Focusable="False"
                  IsEnabled="{Binding IsSeekable}"
                  Thumb.DragStarted="OnTimelineDragStarted" Thumb.DragCompleted="OnTimelineDragCompleted"
                  ToolTip="{x:Static loc:UiText.TimelineTip}" />
        </DockPanel>
        <DockPanel Margin="0,0,0,8">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <TextBlock Text="{x:Static loc:UiText.Volume}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Slider Width="140" VerticalAlignment="Center" Minimum="0" Maximum="100" Value="{Binding VolumePercent}"
                    IsEnabled="{Binding SoundSettingsEditable}" ToolTipService.ShowOnDisabled="True"
                    IsMoveToPointEnabled="True" Focusable="False" SmallChange="1" LargeChange="10"
                    ToolTip="{x:Static loc:UiText.VolumeTip}" />
            <TextBlock Text="{Binding VolumeText}" Width="40" VerticalAlignment="Center" TextAlignment="Right" />
            <ToggleButton Content="{Binding MuteButtonText}" IsChecked="{Binding Muted}" MinWidth="90" Margin="8,0,0,0" Focusable="False"
                          ToolTip="{x:Static loc:UiText.MuteTip}" />
          </StackPanel>
          <WrapPanel>
            <Button Content="{x:Static loc:UiText.PreviousButton}" Command="{Binding PreviousCommand}" ToolTip="{x:Static loc:UiText.PreviousTip}" />
            <Button Content="▶ Play" Command="{Binding PlayCommand}" ToolTip="{x:Static loc:UiText.SpaceBarTip}" />
            <Button Content="⏸ Pause" Command="{Binding PauseCommand}" ToolTip="{x:Static loc:UiText.SpaceBarTip}" />
            <Button Content="⏹ Stop" Command="{Binding StopCommand}" ToolTip="{x:Static loc:UiText.StopTip}" />
            <Button Content="{x:Static loc:UiText.NextButton}" Command="{Binding NextCommand}" ToolTip="{x:Static loc:UiText.NextTip}" />
            <Separator Margin="6,0,12,0" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
            <TextBlock Text="{x:Static loc:UiText.GoTo}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="TimeInputBox" Width="110" VerticalContentAlignment="Center" FontFamily="Consolas"
                     Text="{Binding TimeInput, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{x:Static loc:UiText.GoToTip}">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding GoToTimeCommand}" />
              </TextBox.InputBindings>
            </TextBox>
            <Button Content="{x:Static loc:UiText.GoToButton}" Command="{Binding GoToTimeCommand}" Margin="6,0,6,0" />
          </WrapPanel>
        </DockPanel>
        <DockPanel>
          <WrapPanel>
            <Button Content="{Binding BlackoutButtonText}" Command="{Binding ToggleBlackoutCommand}" MinWidth="150"
                    ToolTip="{x:Static loc:UiText.BlackoutTip}" />
            <Button Content="{Binding FadeButtonText}" Command="{Binding ToggleFadeCommand}" MinWidth="130"
                    ToolTip="{x:Static loc:UiText.FadeTip}" />
            <TextBlock Text="{x:Static loc:UiText.FadeDuration}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="FadeSecondsBox" Width="48" VerticalContentAlignment="Center"
                     Text="{Binding FadeSecondsText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{x:Static loc:UiText.FadeDurationTip}" />
            <TextBlock Text="s" VerticalAlignment="Center" Margin="4,0,12,0" />
            <Button Content="Recenter" Command="{Binding RecenterCommand}" MinWidth="90"
                    ToolTip="{x:Static loc:UiText.RecenterTip}" />
            <Button Content="{x:Static loc:UiText.ResetRecenter}" Command="{Binding ResetRecenterCommand}"
                    ToolTip="{x:Static loc:UiText.ResetRecenterTip}" />
          </WrapPanel>
        </DockPanel>
        <TextBlock Margin="0,8,0,0" Style="{StaticResource PlaceholderText}" FontStyle="Normal"
                   Text="{x:Static loc:UiText.KeysHint}" />
      </StackPanel>
    </GroupBox>
  </Grid>
  </DockPanel>
</Window>
