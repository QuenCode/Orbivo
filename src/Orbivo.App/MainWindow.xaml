<Window x:Class="Orbivo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Orbivo.App.ViewModels"
        xmlns:local="clr-namespace:Orbivo.App"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding Title}"
        Width="1280" Height="800" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="OnPlaylistDrop" DragOver="OnPlaylistDragOver"
        PreviewKeyDown="OnWindowPreviewKeyDown">

  <Grid Margin="6">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="2*" MinWidth="320" />
      <ColumnDefinition Width="3*" MinWidth="420" />
    </Grid.ColumnDefinitions>

    <!-- Playlist (F1–F3): file dialog, drag and drop from Explorer, order, auto-advance, loop -->
    <GroupBox Grid.Row="0" Grid.Column="0" Header="Playlist">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
          <WrapPanel>
            <Button Content="Hinzufügen …" Click="OnAddFilesClick" Margin="0,0,6,4"
                    ToolTip="Videos auswählen. Dateien und Ordner können auch aus dem Explorer hierher gezogen werden." />
            <Button Content="Laden" Command="{Binding LoadSelectedCommand}" Margin="0,0,6,4"
                    ToolTip="Ausgewähltes Video laden (Doppelklick). Läuft gerade ein Video, startet es sofort, sonst bleibt die Brille schwarz bis Play." />
            <Button Content="Entfernen" Command="{Binding RemoveSelectedCommand}" Margin="0,0,6,4" ToolTip="Entf" />
            <Button Content="▲" MinWidth="36" Command="{Binding MoveSelectedUpCommand}" Margin="0,0,6,4" ToolTip="Nach oben" />
            <Button Content="▼" MinWidth="36" Command="{Binding MoveSelectedDownCommand}" Margin="0,0,6,4" ToolTip="Nach unten" />
          </WrapPanel>
          <CheckBox Content="Automatisch weiter zum nächsten Video" IsChecked="{Binding AutoAdvance}" Margin="0,4,0,0" />
          <CheckBox Content="Aktuelles Video wiederholen (Loop)" IsChecked="{Binding Loop}" Margin="0,4,0,0" />
        </StackPanel>
        <Grid>
          <ListBox x:Name="PlaylistBox" ItemsSource="{Binding Playlist.Entries}" SelectedItem="{Binding SelectedEntry}"
                   AllowDrop="True" Drop="OnPlaylistDrop" DragOver="OnPlaylistDragOver"
                   MouseDoubleClick="OnPlaylistDoubleClick" KeyDown="OnPlaylistKeyDown"
                   HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel ToolTip="{Binding Path}">
                  <TextBlock x:Name="Marker" DockPanel.Dock="Left" Width="18" Text="" />
                  <TextBlock x:Name="Name" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="Marker" Property="Text" Value="▶" />
                    <Setter TargetName="Name" Property="FontWeight" Value="Bold" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Style="{StaticResource PlaceholderText}" Margin="12" IsHitTestVisible="False"
                     Text="Noch keine Videos. „Hinzufügen …“ oder Dateien und Ordner aus dem Explorer hierher ziehen.">
            <TextBlock.Visibility>
              <Binding Path="Playlist.Entries.Count">
                <Binding.Converter>
                  <local:ZeroToVisibleConverter />
                </Binding.Converter>
              </Binding>
            </TextBlock.Visibility>
          </TextBlock>
        </Grid>
      </DockPanel>
    </GroupBox>

    <Grid Grid.Row="0" Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Format (M6, F10–F14): applied at once and stored in <video>.orbivo.json -->
      <GroupBox Grid.Row="0" Header="Format" DataContext="{Binding Format}">
        <Grid IsEnabled="{Binding IsAvailable}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.Resources>
            <BooleanToVisibilityConverter x:Key="VisibleIf" />
            <Style TargetType="TextBlock">
              <Setter Property="Margin" Value="0,2,16,2" />
              <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style TargetType="ComboBox">
              <Setter Property="Margin" Value="0,2,0,2" />
              <Setter Property="Focusable" Value="False" />
              <Setter Property="DisplayMemberPath" Value="Label" />
            </Style>
            <Style x:Key="FieldLabel" TargetType="TextBlock">
              <Setter Property="Margin" Value="0,2,4,2" />
              <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="NumberBox" TargetType="TextBox">
              <Setter Property="Width" Value="56" />
              <Setter Property="Margin" Value="0,2,10,2" />
              <Setter Property="VerticalContentAlignment" Value="Center" />
              <EventSetter Event="LostKeyboardFocus" Handler="OnFormatFieldLostFocus" />
            </Style>
            <Style x:Key="HintText" TargetType="TextBlock">
              <Setter Property="TextWrapping" Value="Wrap" />
              <Style.Triggers>
                <Trigger Property="Text" Value="">
                  <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </Grid.Resources>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="Projektion:" />
          <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Projections}" SelectedItem="{Binding SelectedProjection}"
                    ToolTip="Automatisch: aus den Metadaten der Datei (sv3d), sonst Equirect 360°." />

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Stereo-Layout:" />
          <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Layouts}" SelectedItem="{Binding SelectedLayout}"
                    IsEnabled="{Binding CanChooseLayout}"
                    ToolTip="Automatisch: aus den Metadaten (st3d), sonst aus der Bildgröße geschätzt. Linkes Auge oben bzw. links." />

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Augen:" />
          <CheckBox Grid.Row="2" Grid.Column="1" Content="Augen tauschen" IsChecked="{Binding SwapEyes}" IsEnabled="{Binding CanSwapEyes}"
                    Focusable="False" VerticalAlignment="Center" Margin="0,2,0,2"
                    ToolTip="Linkes und rechtes Halbbild vertauschen, wenn die Tiefe falsch herum wirkt." />

          <TextBlock Grid.Row="3" Grid.Column="0" Text="Würfel-Layout:" Visibility="{Binding ShowsCubemap, Converter={StaticResource VisibleIf}}" />
          <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding CubemapLayouts}" SelectedItem="{Binding SelectedCubemap}"
                    Visibility="{Binding ShowsCubemap, Converter={StaticResource VisibleIf}}"
                    ToolTip="Anordnung der sechs Würfelseiten je Auge. Automatisch: 3 × 2, bei EAC das YouTube-Layout." />

          <TextBlock Grid.Row="4" Grid.Column="0" Text="Fisheye:" Visibility="{Binding ShowsFisheye, Converter={StaticResource VisibleIf}}" />
          <WrapPanel Grid.Row="4" Grid.Column="1" Visibility="{Binding ShowsFisheye, Converter={StaticResource VisibleIf}}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Sichtfeld °" />
            <TextBox Style="{StaticResource NumberBox}" Text="{Binding FovText, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding ApplyFisheyeCommand}"
                     ToolTip="Sichtfeld des Kreises in Grad (60–360). Übernehmen mit Enter.">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding ApplyFisheyeCommand}" />
              </TextBox.InputBindings>
            </TextBox>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Mitte X" />
            <TextBox Style="{StaticResource NumberBox}" Text="{Binding CenterXText, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding ApplyFisheyeCommand}"
                     ToolTip="Kreismitte, 0 = linker, 1 = rechter Rand des Halbbilds.">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding ApplyFisheyeCommand}" />
              </TextBox.InputBindings>
            </TextBox>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Y" />
            <TextBox Style="{StaticResource NumberBox}" Text="{Binding CenterYText, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding ApplyFisheyeCommand}"
                     ToolTip="Kreismitte, 0 = oberer, 1 = unterer Rand des Halbbilds.">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding ApplyFisheyeCommand}" />
              </TextBox.InputBindings>
            </TextBox>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Radius" />
            <TextBox Style="{StaticResource NumberBox}" Text="{Binding RadiusText, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding ApplyFisheyeCommand}"
                     ToolTip="Kreisradius als Anteil der Halbbildhöhe (0,5 = berührt oben und unten).">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding ApplyFisheyeCommand}" />
              </TextBox.InputBindings>
            </TextBox>
            <Button Content="Standard" MinWidth="0" Command="{Binding ResetFisheyeCommand}" Focusable="False" ToolTip="180°, mittig, bildhoch" />
          </WrapPanel>

          <TextBlock Grid.Row="5" Grid.Column="0" Text="Ausrichtung:" />
          <WrapPanel Grid.Row="5" Grid.Column="1">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Yaw °" />
            <TextBox Style="{StaticResource NumberBox}" Text="{Binding YawText, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding ApplyOffsetCommand}"
                     ToolTip="Drehung um die Hochachse. Positiv: das Bild dreht nach links, die bisherige Mitte liegt dann links. Übernehmen mit Enter.">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding ApplyOffsetCommand}" />
              </TextBox.InputBindings>
            </TextBox>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Pitch °" />
            <TextBox Style="{StaticResource NumberBox}" Text="{Binding PitchText, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding ApplyOffsetCommand}"
                     ToolTip="Neigung. Positiv: die bisherige Mitte wandert nach oben.">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding ApplyOffsetCommand}" />
              </TextBox.InputBindings>
            </TextBox>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Roll °" />
            <TextBox Style="{StaticResource NumberBox}" Text="{Binding RollText, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding ApplyOffsetCommand}"
                     ToolTip="Kippen um die Blickachse. Positiv: gegen den Uhrzeigersinn, wie der Betrachter es sieht.">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding ApplyOffsetCommand}" />
              </TextBox.InputBindings>
            </TextBox>
            <Button Content="0" MinWidth="0" Command="{Binding ResetOffsetCommand}" Focusable="False" ToolTip="Ausrichtung zurücksetzen" />
          </WrapPanel>

          <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource HintText}" Text="{Binding InputError}" Foreground="Firebrick" />

          <TextBlock Grid.Row="7" Grid.Column="0" Text="Metadaten:" />
          <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding MetadataText}" TextWrapping="Wrap" />

          <TextBlock Grid.Row="8" Grid.Column="0" Text="Sidecar:" />
          <DockPanel Grid.Row="8" Grid.Column="1">
            <Button DockPanel.Dock="Right" Content="Alles automatisch" Command="{Binding ResetAllCommand}" Focusable="False" Margin="6,2,0,2"
                    ToolTip="Alle Formateinstellungen dieses Videos verwerfen; das Sidecar wird gelöscht (fremde Einträge bleiben)." />
            <TextBlock Text="{Binding SidecarText}" TextWrapping="Wrap" />
          </DockPanel>

          <TextBlock Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource HintText}" Text="{Binding WarningText}"
                     Foreground="DarkGoldenrod" Margin="0,6,0,0" />
        </Grid>
      </GroupBox>

      <!-- Sound (M5): mode and output device (F24) -->
      <GroupBox Grid.Row="1" Header="Ton">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Audio-Modus:" Margin="0,2,16,2" />
          <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AudioModeText}" Margin="0,2,0,2" />
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Tonausgabe:" VerticalAlignment="Center" Margin="0,2,16,2" />
          <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,2,0,2">
            <Button DockPanel.Dock="Right" Content="Aktualisieren" Command="{Binding RefreshAudioDevicesCommand}" Margin="6,0,0,0"
                    ToolTip="Geräteliste neu einlesen (z. B. nach dem Einstecken eines Kopfhörers)" />
            <ComboBox ItemsSource="{Binding AudioDevices}" SelectedItem="{Binding SelectedAudioDevice}" Focusable="False"
                      ToolTip="Gerät für die Kopfhörer. Windows-Standard folgt dem Standardgerät; ein fest gewähltes Gerät wird nie automatisch gewechselt." />
          </DockPanel>
        </Grid>
      </GroupBox>

      <!-- Status (F40/F41, filled from M2 on) -->
      <GroupBox Grid.Row="2" Header="Status">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding StatusEntries}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:StatusEntry}">
                <Grid Margin="0,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Ellipse x:Name="Indicator" Grid.Column="0" Width="10" Height="10"
                           VerticalAlignment="Center" Fill="LightGray" />
                  <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold" />
                  <TextBox Grid.Column="2" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True"
                           BorderThickness="0" Background="Transparent" TextWrapping="Wrap" />
                </Grid>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Level}" Value="{x:Static vm:StatusLevel.Ok}">
                    <Setter TargetName="Indicator" Property="Fill" Value="ForestGreen" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Level}" Value="{x:Static vm:StatusLevel.Warning}">
                    <Setter TargetName="Indicator" Property="Fill" Value="Orange" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Level}" Value="{x:Static vm:StatusLevel.Error}">
                    <Setter TargetName="Indicator" Property="Fill" Value="Firebrick" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </GroupBox>
    </Grid>

    <!-- Transport (F2, F5, F60): timeline, time input, playlist navigation, blackout and fade -->
    <GroupBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Header="Wiedergabe">
      <StackPanel>
        <Border x:Name="OutputBanner" Padding="10,6" Margin="0,0,0,8" CornerRadius="3">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="#FF303030" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding OutputStatusLevel}" Value="{x:Static vm:StatusLevel.Ok}">
                  <Setter Property="Background" Value="#FF2E7D32" />
                </DataTrigger>
                <DataTrigger Binding="{Binding OutputStatusLevel}" Value="{x:Static vm:StatusLevel.Warning}">
                  <Setter Property="Background" Value="#FFB26A00" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock Text="{Binding OutputText}" Foreground="White" FontSize="16" FontWeight="SemiBold" />
        </Border>
        <DockPanel Margin="0,0,0,8">
          <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center"
                     FontFamily="Consolas" FontSize="14" Text="{Binding TimeText}" />
          <Slider x:Name="Timeline" VerticalAlignment="Center" Minimum="0" Maximum="{Binding DurationSeconds}"
                  Value="{Binding TimelineSeconds}" IsMoveToPointEnabled="True" Focusable="False"
                  IsEnabled="{Binding IsSeekable}"
                  Thumb.DragStarted="OnTimelineDragStarted" Thumb.DragCompleted="OnTimelineDragCompleted"
                  ToolTip="Klicken oder ziehen zum Springen" />
        </DockPanel>
        <DockPanel Margin="0,0,0,8">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <TextBlock Text="Lautstärke" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Slider Width="140" VerticalAlignment="Center" Minimum="0" Maximum="100" Value="{Binding VolumePercent}"
                    IsMoveToPointEnabled="True" Focusable="False" SmallChange="1" LargeChange="10"
                    ToolTip="Lautstärke der Kopfhörer (nur Orbivo, nicht die Windows-Lautstärke)" />
            <TextBlock Text="{Binding VolumeText}" Width="40" VerticalAlignment="Center" TextAlignment="Right" />
            <ToggleButton Content="{Binding MuteButtonText}" IsChecked="{Binding Muted}" MinWidth="90" Margin="8,0,0,0" Focusable="False"
                          ToolTip="Ton aus und wieder an, weich ohne Knacken (Taste M)" />
          </StackPanel>
          <WrapPanel>
            <Button Content="⏮ Zurück" Command="{Binding PreviousCommand}" ToolTip="Vorheriges Video (Bild↑)" />
            <Button Content="▶ Play" Command="{Binding PlayCommand}" ToolTip="Leertaste" />
            <Button Content="⏸ Pause" Command="{Binding PauseCommand}" ToolTip="Leertaste" />
            <Button Content="⏹ Stop" Command="{Binding StopCommand}" ToolTip="Zurück zum Anfang, Brille schwarz" />
            <Button Content="⏭ Weiter" Command="{Binding NextCommand}" ToolTip="Nächstes Video (Bild↓)" />
            <Separator Margin="6,0,12,0" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
            <TextBlock Text="Gehe zu" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="TimeInputBox" Width="110" VerticalContentAlignment="Center" FontFamily="Consolas"
                     Text="{Binding TimeInput, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Zeit eingeben und Enter drücken, z. B. 83, 1:23, 1:23.5 oder 0:01:23,5">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding GoToTimeCommand}" />
              </TextBox.InputBindings>
            </TextBox>
            <Button Content="Springen" Command="{Binding GoToTimeCommand}" Margin="6,0,6,0" />
          </WrapPanel>
        </DockPanel>
        <DockPanel>
          <WrapPanel>
            <Button Content="{Binding BlackoutButtonText}" Command="{Binding ToggleBlackoutCommand}" MinWidth="150"
                    ToolTip="Brille sofort schwarz bzw. wieder Bild, unabhängig von der Wiedergabe" />
            <Button Content="{Binding FadeButtonText}" Command="{Binding ToggleFadeCommand}" MinWidth="130"
                    ToolTip="Weich nach Schwarz bzw. zurück zum Bild blenden" />
            <TextBlock Text="Dauer" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="FadeSecondsBox" Width="48" VerticalContentAlignment="Center"
                     Text="{Binding FadeSecondsText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Fade-Dauer in Sekunden (0,1 bis 30)" />
            <TextBlock Text="s" VerticalAlignment="Center" Margin="4,0,12,0" />
            <Button Content="Recenter" IsEnabled="False" ToolTip="Folgt in M8 (Taste R)" />
          </WrapPanel>
        </DockPanel>
        <TextBlock Style="{StaticResource PlaceholderText}" Margin="0,8,0,0" FontStyle="Normal"
                   Text="Tasten: Leertaste Play/Pause · ←/→ ±5 s · Shift+←/→ ±30 s · , / . Einzelbild · Bild↑/Bild↓ Video zurück/weiter · B Schwarzbild · F Fade · M Stumm" />
      </StackPanel>
    </GroupBox>
  </Grid>
</Window>
