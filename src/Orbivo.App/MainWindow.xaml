<Window x:Class="Orbivo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Orbivo.App.ViewModels"
        xmlns:local="clr-namespace:Orbivo.App"
        xmlns:lv="clr-namespace:Orbivo.App.LiveView"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding Title}"
        Icon="/Assets/orbivo.ico"
        Width="1280" Height="800" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="OnPlaylistDrop" DragOver="OnPlaylistDragOver"
        PreviewKeyDown="OnWindowPreviewKeyDown">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="VisibleIfTrue" />
  </Window.Resources>

  <Grid Margin="6">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="2*" MinWidth="320" />
      <ColumnDefinition Width="3*" MinWidth="420" />
    </Grid.ColumnDefinitions>

    <Grid Grid.Row="0" Grid.Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Playlist (F1–F3), compact: usually one to three videos. File dialog, drag and drop from Explorer, order, auto-advance, loop -->
      <GroupBox Grid.Row="0" Header="Playlist">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <WrapPanel>
              <Button Content="Hinzufügen …" Click="OnAddFilesClick" Margin="0,0,6,4"
                      ToolTip="Videos auswählen. Dateien und Ordner können auch aus dem Explorer hierher gezogen werden." />
              <Button Content="Laden" Command="{Binding LoadSelectedCommand}" Margin="0,0,6,4"
                      ToolTip="Ausgewähltes Video laden (Doppelklick). Läuft gerade ein Video, startet es sofort, sonst bleibt die Brille schwarz bis Play." />
              <Button Content="Entfernen" Command="{Binding RemoveSelectedCommand}" Margin="0,0,6,4" ToolTipService.ShowOnDisabled="True"
                      ToolTip="Aus der Playlist entfernen (Entf). Das geladene Video erst nach Stop; danach ist die Datei frei." />
              <Button Content="▲" MinWidth="36" Command="{Binding MoveSelectedUpCommand}" Margin="0,0,6,4" ToolTip="Nach oben" />
              <Button Content="▼" MinWidth="36" Command="{Binding MoveSelectedDownCommand}" Margin="0,0,6,4" ToolTip="Nach unten" />
            </WrapPanel>
            <CheckBox Content="Automatisch weiter zum nächsten Video" IsChecked="{Binding AutoAdvance}" Margin="0,4,0,0" />
            <CheckBox Content="Aktuelles Video wiederholen (Loop)" IsChecked="{Binding Loop}" Margin="0,4,0,0" />
          </StackPanel>
          <Grid>
            <ListBox x:Name="PlaylistBox" Height="112" ItemsSource="{Binding Playlist.Entries}" SelectedItem="{Binding SelectedEntry}"
                     AllowDrop="True" Drop="OnPlaylistDrop" DragOver="OnPlaylistDragOver"
                     MouseDoubleClick="OnPlaylistDoubleClick" KeyDown="OnPlaylistKeyDown"
                     HorizontalContentAlignment="Stretch">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel ToolTip="{Binding Path}">
                    <TextBlock x:Name="Marker" DockPanel.Dock="Left" Width="18" Text="" />
                    <TextBlock x:Name="Name" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                  </DockPanel>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                      <Setter TargetName="Marker" Property="Text" Value="▶" />
                      <Setter TargetName="Name" Property="FontWeight" Value="Bold" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Style="{StaticResource PlaceholderText}" Margin="12" IsHitTestVisible="False"
                       Text="Noch keine Videos. „Hinzufügen …“ oder Dateien und Ordner aus dem Explorer hierher ziehen.">
              <TextBlock.Visibility>
                <Binding Path="Playlist.Entries.Count">
                  <Binding.Converter>
                    <local:ZeroToVisibleConverter />
                  </Binding.Converter>
                </Binding>
              </TextBlock.Visibility>
            </TextBlock>
          </Grid>
        </DockPanel>
      </GroupBox>

      <!-- Format (M6, F10–F14): applied at once and stored in <video>.orbivo.json -->
      <GroupBox Grid.Row="1" Header="Format" DataContext="{Binding Format}">
        <Grid IsEnabled="{Binding IsAvailable}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.Resources>
            <BooleanToVisibilityConverter x:Key="VisibleIf" />
            <Style TargetType="TextBlock">
              <Setter Property="Margin" Value="0,2,16,2" />
              <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style TargetType="ComboBox">
              <Setter Property="Margin" Value="0,2,0,2" />
              <Setter Property="Focusable" Value="False" />
              <Setter Property="DisplayMemberPath" Value="Label" />
            </Style>
            <Style x:Key="FieldLabel" TargetType="TextBlock">
              <Setter Property="Margin" Value="0,2,4,2" />
              <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="NumberBox" TargetType="TextBox">
              <Setter Property="Width" Value="56" />
              <Setter Property="Margin" Value="0,2,10,2" />
              <Setter Property="VerticalContentAlignment" Value="Center" />
              <EventSetter Event="LostKeyboardFocus" Handler="OnFormatFieldLostFocus" />
            </Style>
            <Style x:Key="HintText" TargetType="TextBlock">
              <Setter Property="TextWrapping" Value="Wrap" />
              <Style.Triggers>
                <Trigger Property="Text" Value="">
                  <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </Grid.Resources>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="Projektion:" />
          <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Projections}" SelectedItem="{Binding SelectedProjection}"
                    ToolTip="Automatisch: aus den Metadaten der Datei (sv3d), sonst Equirect 360°." />

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Stereo-Layout:" />
          <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Layouts}" SelectedItem="{Binding SelectedLayout}"
                    IsEnabled="{Binding CanChooseLayout}"
                    ToolTip="Automatisch: aus den Metadaten (st3d), sonst aus der Bildgröße geschätzt. Linkes Auge oben bzw. links." />

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Augen:" />
          <CheckBox Grid.Row="2" Grid.Column="1" Content="Augen tauschen" IsChecked="{Binding SwapEyes}" IsEnabled="{Binding CanSwapEyes}"
                    Focusable="False" VerticalAlignment="Center" Margin="0,2,0,2"
                    ToolTip="Linkes und rechtes Halbbild vertauschen, wenn die Tiefe falsch herum wirkt." />

          <TextBlock Grid.Row="3" Grid.Column="0" Text="Würfel-Layout:" Visibility="{Binding ShowsCubemap, Converter={StaticResource VisibleIf}}" />
          <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding CubemapLayouts}" SelectedItem="{Binding SelectedCubemap}"
                    Visibility="{Binding ShowsCubemap, Converter={StaticResource VisibleIf}}"
                    ToolTip="Anordnung der sechs Würfelseiten je Auge. Automatisch: 3 × 2, bei EAC das YouTube-Layout." />

          <TextBlock Grid.Row="4" Grid.Column="0" Text="Fisheye:" Visibility="{Binding ShowsFisheye, Converter={StaticResource VisibleIf}}" />
          <WrapPanel Grid.Row="4" Grid.Column="1" Visibility="{Binding ShowsFisheye, Converter={StaticResource VisibleIf}}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Sichtfeld °" />
            <TextBox Style="{StaticResource NumberBox}" Text="{Binding FovText, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding ApplyFisheyeCommand}"
                     ToolTip="Sichtfeld des Kreises in Grad (60–360). Übernehmen mit Enter.">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding ApplyFisheyeCommand}" />
              </TextBox.InputBindings>
            </TextBox>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Mitte X" />
            <TextBox Style="{StaticResource NumberBox}" Text="{Binding CenterXText, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding ApplyFisheyeCommand}"
                     ToolTip="Kreismitte, 0 = linker, 1 = rechter Rand des Halbbilds.">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding ApplyFisheyeCommand}" />
              </TextBox.InputBindings>
            </TextBox>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Y" />
            <TextBox Style="{StaticResource NumberBox}" Text="{Binding CenterYText, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding ApplyFisheyeCommand}"
                     ToolTip="Kreismitte, 0 = oberer, 1 = unterer Rand des Halbbilds.">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding ApplyFisheyeCommand}" />
              </TextBox.InputBindings>
            </TextBox>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Radius" />
            <TextBox Style="{StaticResource NumberBox}" Text="{Binding RadiusText, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding ApplyFisheyeCommand}"
                     ToolTip="Kreisradius als Anteil der Halbbildhöhe (0,5 = berührt oben und unten).">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding ApplyFisheyeCommand}" />
              </TextBox.InputBindings>
            </TextBox>
            <Button Content="Standard" MinWidth="0" Command="{Binding ResetFisheyeCommand}" Focusable="False" ToolTip="180°, mittig, bildhoch" />
          </WrapPanel>

          <TextBlock Grid.Row="5" Grid.Column="0" Text="Ausrichtung:" />
          <WrapPanel Grid.Row="5" Grid.Column="1">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Yaw °" />
            <TextBox Style="{StaticResource NumberBox}" Text="{Binding YawText, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding ApplyOffsetCommand}"
                     ToolTip="Drehung um die Hochachse. Positiv: das Bild dreht nach links, die bisherige Mitte liegt dann links. Übernehmen mit Enter.">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding ApplyOffsetCommand}" />
              </TextBox.InputBindings>
            </TextBox>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Pitch °" />
            <TextBox Style="{StaticResource NumberBox}" Text="{Binding PitchText, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding ApplyOffsetCommand}"
                     ToolTip="Neigung. Positiv: die bisherige Mitte wandert nach oben.">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding ApplyOffsetCommand}" />
              </TextBox.InputBindings>
            </TextBox>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Roll °" />
            <TextBox Style="{StaticResource NumberBox}" Text="{Binding RollText, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding ApplyOffsetCommand}"
                     ToolTip="Kippen um die Blickachse. Positiv: gegen den Uhrzeigersinn, wie der Betrachter es sieht.">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding ApplyOffsetCommand}" />
              </TextBox.InputBindings>
            </TextBox>
            <Button Content="0" MinWidth="0" Command="{Binding ResetOffsetCommand}" Focusable="False" ToolTip="Ausrichtung zurücksetzen" />
          </WrapPanel>

          <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource HintText}" Text="{Binding InputError}" Foreground="Firebrick" />

          <TextBlock Grid.Row="7" Grid.Column="0" Text="Metadaten:" />
          <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding MetadataText}" TextWrapping="Wrap" />

          <TextBlock Grid.Row="8" Grid.Column="0" Text="Sidecar:" />
          <DockPanel Grid.Row="8" Grid.Column="1">
            <Button DockPanel.Dock="Right" Content="Alles automatisch" Command="{Binding ResetAllCommand}" Focusable="False" Margin="6,2,0,2"
                    ToolTip="Alle Format- und Toneinstellungen dieses Videos verwerfen; das Sidecar wird gelöscht (fremde Einträge bleiben)." />
            <TextBlock Text="{Binding SidecarText}" TextWrapping="Wrap" />
          </DockPanel>

          <TextBlock Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource HintText}" Text="{Binding WarningText}"
                     Foreground="DarkGoldenrod" Margin="0,6,0,0" />
        </Grid>
      </GroupBox>

      <!-- Live view (F42): what the participant sees, copied from the render thread about 30 times per second -->
      <GroupBox Grid.Row="2" Header="Live-Ansicht (was der Proband sieht)">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <CheckBox Content="Anzeigen" IsChecked="{Binding LiveViewEnabled}" Focusable="False" VerticalAlignment="Center"
                      ToolTip="Zeigt das Bild der Brille aus dem Blickwinkel des Probanden (beide Augen zusammen, linkes Halbbild). Bei jedem Start aus; abgeschaltet kostet es keine Rechenzeit." />
            <TextBlock Text="{Binding LiveViewStatusText}" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </DockPanel>
          <Grid Background="Black" MinHeight="120">
            <lv:LiveViewHost x:Name="LiveViewPanel" Visibility="{Binding LiveViewEnabled, Converter={StaticResource VisibleIfTrue}}" />
            <TextBlock Text="Aus" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding LiveViewEnabled}" Value="True">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
        </DockPanel>
      </GroupBox>
    </Grid>

    <Grid Grid.Row="0" Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>


      <!-- Sound (M5): mode and output device (F24) -->
      <GroupBox Grid.Row="0" Header="Ton">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Audio-Modus:" Margin="0,2,16,2" />
          <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AudioModeText}" TextWrapping="Wrap" Margin="0,2,0,2" />
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Tonformat:" VerticalAlignment="Center" Margin="0,2,16,2" />
          <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Format.AudioModes}" SelectedItem="{Binding Format.SelectedAudioMode}"
                    IsEnabled="{Binding Format.CanChooseAudioMode}" Focusable="False" Margin="0,2,0,2" HorizontalAlignment="Left" MinWidth="260"
                    ToolTip="Wie die Kanäle der Tonspur gemeint sind. Automatisch: Ambisonics laut Metadaten (SA3D); 4, 9 oder 16 Kanäle ohne Angabe gelten als Ambisonics AmbiX. Kanäle: Mono und Stereo wie sie sind, mehr Kanäle auf Stereo gemischt. FuMa: ältere Ambisonics-Aufnahmen (W X Y Z). Wird pro Video im Sidecar gespeichert; der Ton setzt dabei kurz neu an." />
          <TextBlock Grid.Row="2" Grid.Column="0" Text="Richtung:" VerticalAlignment="Center" Margin="0,2,16,2" />
          <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,2,0,2">
            <CheckBox Content="Ton fest am Bild" IsChecked="{Binding Format.SoundFixedToPicture}" IsEnabled="{Binding Format.IsAvailable}"
                      Focusable="False" VerticalAlignment="Center"
                      ToolTip="Ein: Der Ton steht fest im Video. Bei Stereo kommen links und rechts von zwei Lautsprechern im Bild, bei Ambisonics bleibt das ganze Klangfeld am Bild. Dreht der Proband den Kopf, wandert der Ton mit dem Bild. Aus: Der Ton dreht mit dem Kopf (Stereo unverändert, Ambisonics immer von vorne gehört). Wird pro Video im Sidecar gespeichert." />
            <TextBlock Text="Breite:" VerticalAlignment="Center" Margin="16,0,6,0" />
            <ComboBox ItemsSource="{Binding Format.StereoWidths}" SelectedItem="{Binding Format.SelectedStereoWidth}"
                      IsEnabled="{Binding Format.CanChooseStereoWidth}" Focusable="False" MinWidth="110" HorizontalAlignment="Left"
                      ToolTip="Nur Stereo: Winkel der beiden virtuellen Lautsprecher links und rechts von der Bildmitte. Standard 75°; größer klingt breiter, kleiner enger (eine übliche Stereo-Aufstellung hätte 30°)." />
          </DockPanel>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="Tonausgabe:" VerticalAlignment="Center" Margin="0,2,16,2" />
          <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,2,0,2">
            <Button DockPanel.Dock="Right" Content="Aktualisieren" Command="{Binding RefreshAudioDevicesCommand}" Margin="6,0,0,0"
                    ToolTip="Geräteliste neu einlesen (z. B. nach dem Einstecken eines Kopfhörers)" />
            <ComboBox ItemsSource="{Binding AudioDevices}" SelectedItem="{Binding SelectedAudioDevice}" Focusable="False"
                      IsEnabled="{Binding SoundSettingsEditable}"
                      ToolTip="Gerät für die Kopfhörer. Windows-Standard folgt dem Standardgerät; ein fest gewähltes Gerät wird nie automatisch gewechselt." />
          </DockPanel>
          <CheckBox Grid.Row="4" Grid.Column="1" Content="Tonausgabe und Lautstärke sperren" IsChecked="{Binding SoundLocked}"
                    Focusable="False" Margin="0,4,0,2"
                    ToolTip="Schützt Gerät und Lautstärke vor versehentlichem Verstellen. Bleibt nach einem Neustart erhalten. Stumm (M) geht weiter." />
        </Grid>
      </GroupBox>

      <!-- Idle view (F7): what the headset shows while no video runs; kept in settings.json -->
      <GroupBox Grid.Row="1" Header="Brille im Leerlauf (vor Play, nach Stop, ohne Video)" DataContext="{Binding Idle}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Anzeige:" VerticalAlignment="Center" Margin="0,2,16,2" />
          <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,2,0,2">
            <Button DockPanel.Dock="Right" Content="Bild wählen …" Click="OnChooseIdleImageClick" Margin="6,0,0,0" Focusable="False"
                    ToolTip="Equirect-360°-Bild (PNG, JPG). Quadratisch = Top-Bottom, 4:1 = Side-by-Side, sonst Mono" />
            <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" DisplayMemberPath="Label" Focusable="False"
                      MinWidth="200" HorizontalAlignment="Left"
                      ToolTip="Was der Proband sieht, solange kein Video läuft. Pause und Ende zeigen weiter das Videobild. Schwarzbild (B) und Fade wirken auch hier; Schwarzbild bleibt immer schwarz. Wird gespeichert." />
          </DockPanel>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Standbild:" Margin="0,2,16,2"
                     Visibility="{Binding ShowsImageRow, Converter={StaticResource VisibleIfTrue}}" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ImageText}" TextWrapping="Wrap" Margin="0,2,0,2"
                     ToolTip="{Binding ImagePath}" Visibility="{Binding ShowsImageRow, Converter={StaticResource VisibleIfTrue}}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ImageLevel}" Value="{x:Static vm:StatusLevel.Error}">
                    <Setter Property="Foreground" Value="Firebrick" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="See-through:" Margin="0,2,16,2" />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SeeThroughText}" TextWrapping="Wrap" Margin="0,2,0,2" />
        </Grid>
      </GroupBox>

      <!-- Recording (F50-F52): head log and event log as German CSV; on, folder and rate kept in settings.json -->
      <GroupBox Grid.Row="2" Header="Aufzeichnung (Kopf-CSV und Ereignis-Log)" DataContext="{Binding Recording}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <WrapPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,2,0,2">
            <CheckBox Content="Aufzeichnen" IsChecked="{Binding Enabled}" Focusable="False" Margin="0,0,24,0"
                      ToolTip="Schreibt Kopfbewegung (Kopf-CSV) und Bedienereignisse (Ereignis-CSV), Trennzeichen Semikolon, Dezimalkomma, Uhrzeit dieses PCs. Jedes Einschalten beginnt ein neues Dateipaar. Bleibt nach einem Neustart eingeschaltet." />
            <CheckBox Content="Nur bei laufendem Video" IsChecked="{Binding PerVideo}" IsEnabled="{Binding CanEdit}" Focusable="False"
                      ToolTip="Ein Dateipaar je Video: Play beginnt es (Dateiname mit Videoname), Stop, Videoende, Entladen oder ein anderes Video beenden es. Pause bleibt in derselben Datei. Ohne laufendes Video wird nichts geschrieben. Nur änderbar, solange die Aufzeichnung aus ist; wird gespeichert." />
          </WrapPanel>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Ordner:" VerticalAlignment="Center" Margin="0,2,16,2" />
          <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,2,0,2">
            <Button DockPanel.Dock="Right" Content="Ordner wählen …" Click="OnChooseRecordingFolderClick" Margin="6,0,0,0" Focusable="False"
                    IsEnabled="{Binding CanEdit}" ToolTip="Nur änderbar, solange keine Aufzeichnung läuft" />
            <TextBlock Text="{Binding Folder}" ToolTip="{Binding Folder}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="Proband/Sitzung:" VerticalAlignment="Center" Margin="0,2,16,2" />
          <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" Margin="0,2,0,2"
                   ToolTip="Optional, wird Teil der Dateinamen (z. B. 2026-11-08_141203_P07_kopf.csv). Wird nicht gespeichert." />
          <TextBlock Grid.Row="3" Grid.Column="0" Text="Kopf-Rate:" VerticalAlignment="Center" Margin="0,2,16,2" />
          <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Rates}" SelectedItem="{Binding SelectedRate}" DisplayMemberPath="Label" Focusable="False"
                    MinWidth="200" HorizontalAlignment="Left" Margin="0,2,0,2"
                    ToolTip="Zeilen pro Sekunde in der Kopf-CSV. Wirkt sofort, auch während einer Aufzeichnung." />
          <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding StatusLevel}" Value="{x:Static vm:StatusLevel.Error}">
                      <Setter Property="Foreground" Value="Firebrick" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StatusLevel}" Value="{x:Static vm:StatusLevel.Warning}">
                      <Setter Property="Foreground" Value="DarkGoldenrod" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding FileText}" ToolTip="{Binding FilePath}" TextTrimming="CharacterEllipsis">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Style.Triggers>
                    <Trigger Property="Text" Value="">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Grid>
      </GroupBox>

      <!-- Status (F40/F41, filled from M2 on) -->
      <GroupBox Grid.Row="3" Header="Status">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding StatusEntries}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:StatusEntry}">
                <Grid Margin="0,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Ellipse x:Name="Indicator" Grid.Column="0" Width="10" Height="10"
                           VerticalAlignment="Center" Fill="LightGray" />
                  <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold" />
                  <TextBox Grid.Column="2" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True"
                           BorderThickness="0" Background="Transparent" TextWrapping="Wrap" />
                </Grid>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Level}" Value="{x:Static vm:StatusLevel.Ok}">
                    <Setter TargetName="Indicator" Property="Fill" Value="ForestGreen" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Level}" Value="{x:Static vm:StatusLevel.Warning}">
                    <Setter TargetName="Indicator" Property="Fill" Value="Orange" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Level}" Value="{x:Static vm:StatusLevel.Error}">
                    <Setter TargetName="Indicator" Property="Fill" Value="Firebrick" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </GroupBox>
    </Grid>

    <!-- Transport (F2, F5, F60): timeline, time input, playlist navigation, blackout and fade -->
    <GroupBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Header="Wiedergabe">
      <StackPanel>
        <Border x:Name="OutputBanner" Padding="10,6" Margin="0,0,0,8" CornerRadius="3">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="#FF303030" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding OutputStatusLevel}" Value="{x:Static vm:StatusLevel.Ok}">
                  <Setter Property="Background" Value="#FF2E7D32" />
                </DataTrigger>
                <DataTrigger Binding="{Binding OutputStatusLevel}" Value="{x:Static vm:StatusLevel.Warning}">
                  <Setter Property="Background" Value="#FFB26A00" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock Text="{Binding OutputText}" Foreground="White" FontSize="16" FontWeight="SemiBold" />
        </Border>
        <DockPanel Margin="0,0,0,8">
          <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center"
                     FontFamily="Consolas" FontSize="14" Text="{Binding TimeText}" />
          <Slider x:Name="Timeline" VerticalAlignment="Center" Minimum="0" Maximum="{Binding DurationSeconds}"
                  Value="{Binding TimelineSeconds}" IsMoveToPointEnabled="True" Focusable="False"
                  IsEnabled="{Binding IsSeekable}"
                  Thumb.DragStarted="OnTimelineDragStarted" Thumb.DragCompleted="OnTimelineDragCompleted"
                  ToolTip="Klicken oder ziehen zum Springen" />
        </DockPanel>
        <DockPanel Margin="0,0,0,8">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <TextBlock Text="Lautstärke" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Slider Width="140" VerticalAlignment="Center" Minimum="0" Maximum="100" Value="{Binding VolumePercent}"
                    IsEnabled="{Binding SoundSettingsEditable}" ToolTipService.ShowOnDisabled="True"
                    IsMoveToPointEnabled="True" Focusable="False" SmallChange="1" LargeChange="10"
                    ToolTip="Lautstärke der Kopfhörer (nur Orbivo, nicht die Windows-Lautstärke). Gesperrt, solange „Tonausgabe und Lautstärke sperren“ an ist." />
            <TextBlock Text="{Binding VolumeText}" Width="40" VerticalAlignment="Center" TextAlignment="Right" />
            <ToggleButton Content="{Binding MuteButtonText}" IsChecked="{Binding Muted}" MinWidth="90" Margin="8,0,0,0" Focusable="False"
                          ToolTip="Ton aus und wieder an, weich ohne Knacken (Taste M)" />
          </StackPanel>
          <WrapPanel>
            <Button Content="⏮ Zurück" Command="{Binding PreviousCommand}" ToolTip="Vorheriges Video (Bild↑)" />
            <Button Content="▶ Play" Command="{Binding PlayCommand}" ToolTip="Leertaste" />
            <Button Content="⏸ Pause" Command="{Binding PauseCommand}" ToolTip="Leertaste" />
            <Button Content="⏹ Stop" Command="{Binding StopCommand}" ToolTip="Zurück zum Anfang, Brille schwarz" />
            <Button Content="⏭ Weiter" Command="{Binding NextCommand}" ToolTip="Nächstes Video (Bild↓)" />
            <Separator Margin="6,0,12,0" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
            <TextBlock Text="Gehe zu" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="TimeInputBox" Width="110" VerticalContentAlignment="Center" FontFamily="Consolas"
                     Text="{Binding TimeInput, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Zeit eingeben und Enter drücken, z. B. 83, 1:23, 1:23.5 oder 0:01:23,5">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding GoToTimeCommand}" />
              </TextBox.InputBindings>
            </TextBox>
            <Button Content="Springen" Command="{Binding GoToTimeCommand}" Margin="6,0,6,0" />
          </WrapPanel>
        </DockPanel>
        <DockPanel>
          <WrapPanel>
            <Button Content="{Binding BlackoutButtonText}" Command="{Binding ToggleBlackoutCommand}" MinWidth="150"
                    ToolTip="Brille sofort schwarz bzw. wieder Bild, unabhängig von der Wiedergabe" />
            <Button Content="{Binding FadeButtonText}" Command="{Binding ToggleFadeCommand}" MinWidth="130"
                    ToolTip="Weich nach Schwarz bzw. zurück zum Bild blenden" />
            <TextBlock Text="Dauer" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="FadeSecondsBox" Width="48" VerticalContentAlignment="Center"
                     Text="{Binding FadeSecondsText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Fade-Dauer in Sekunden (0,1 bis 30)" />
            <TextBlock Text="s" VerticalAlignment="Center" Margin="4,0,12,0" />
            <Button Content="Recenter" Command="{Binding RecenterCommand}" MinWidth="90"
                    ToolTip="Die aktuelle Blickrichtung des Probanden wird die Vorderseite des Videos, für Bild und Ton (Taste R). Gilt auch für die nächsten Videos" />
            <Button Content="Recenter zurücksetzen" Command="{Binding ResetRecenterCommand}"
                    ToolTip="Wieder die Vorderseite des Videos (Shift+R)" />
          </WrapPanel>
        </DockPanel>
        <DockPanel Margin="0,8,0,0">
          <!-- Operator manual (M9): Anleitung.html next to the exe -->
          <TextBlock DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Top">
            <Hyperlink Command="{Binding OpenManualCommand}" Focusable="False"
                       ToolTip="Bedienungsanleitung und Erklärung der Aufzeichnungsdaten im Browser öffnen (F1)">Anleitung (F1)</Hyperlink>
          </TextBlock>
          <TextBlock Style="{StaticResource PlaceholderText}" FontStyle="Normal"
                     Text="Tasten: Leertaste Play/Pause · ←/→ ±5 s · Shift+←/→ ±30 s · , / . Einzelbild · Bild↑/Bild↓ Video zurück/weiter · B Schwarzbild · F Fade · M Stumm · R Recenter · Shift+R Recenter zurücksetzen" />
        </DockPanel>
      </StackPanel>
    </GroupBox>
  </Grid>
</Window>
